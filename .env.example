# Supabase (опционально).
# Если не задано — сайт использует статический каталог из src/data.ts.
# Заполните значениями из Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Блокировка админ-панели (по умолчанию включена — /admin показывает заглушку
# «Сервис будет доступен после оплаты»). Чтобы открыть панель, задайте 0.
VITE_ADMIN_LOCKED=1

# Блокировка всего сайта для посетителей (по умолчанию включена — та же заглушка).
# Чтобы открыть сайт, задайте 0.
VITE_SITE_LOCKED=1
