{
  "functions": {
    "api/sitemap.ts": {
      "maxDuration": 10
    },
    "api/product/*.ts": {
      "maxDuration": 10
    },
    "api/yandex-feed.ts": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/catalog",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/yandex-feed.yml",
      "destination": "/api/yandex-feed"
    },
    {
      "source": "/:lang(ru)/product/:id",
      "destination": "/api/product/:id?lang=ru"
    },
    {
      "source": "/:lang(tr)/product/:id",
      "destination": "/api/product/:id?lang=tr"
    },
    {
      "source": "/:lang(en)/product/:id",
      "destination": "/api/product/:id?lang=en"
    },
    {
      "source": "/:lang(ar)/product/:id",
      "destination": "/api/product/:id?lang=ar"
    },
    {
      "source": "/product/:id",
      "destination": "/api/product/:id"
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|yandex-feed\\.yml).*)",
      "destination": "/index.html"
    }
  ]
}
