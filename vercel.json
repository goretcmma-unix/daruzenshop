{
  "functions": {
    "api/sitemap.ts": {
      "maxDuration": 10
    },
    "api/product/*.ts": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/catalog",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/product/:id",
      "destination": "/api/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(Googlebot|YandexBot|bingbot|LinkedInBot|TwitterBot|facebookexternalhit|WhatsApp|TelegramBot|SlackBot|Applebot).*"
        }
      ]
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
