{
  "functions": {
    "api/sitemap.ts": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/catalog",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}