{
  "functions": {
    "api/sitemap.ts": {
      "maxDuration": 10
    },
    "api/home.ts": {
      "maxDuration": 10
    },
    "api/product/*.ts": {
      "maxDuration": 10
    },
    "api/catalog/*.ts": {
      "maxDuration": 10
    },
    "api/yandex-feed.ts": {
      "maxDuration": 10
    },
    "api/google-feed.ts": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/ru",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/ru/about",
      "permanent": false
    },
    {
      "source": "/contacts",
      "destination": "/ru/contacts",
      "permanent": false
    },
    {
      "source": "/catalog",
      "destination": "/ru/catalog",
      "permanent": false
    },
    {
      "source": "/product/",
      "destination": "/#catalog",
      "permanent": false
    },
    {
      "source": "/product",
      "destination": "/#catalog",
      "permanent": false
    },
    {
      "source": "/product/:id",
      "destination": "/ru/product/:id",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/yandex-feed.yml",
      "destination": "/api/yandex-feed"
    },
    {
      "source": "/google-feed.xml",
      "destination": "/api/google-feed"
    },
    {
      "source": "/",
      "destination": "/api/home?lang=ru"
    },
    {
      "source": "/ru",
      "destination": "/api/home?lang=ru"
    },
    {
      "source": "/tr",
      "destination": "/api/home?lang=tr"
    },
    {
      "source": "/en",
      "destination": "/api/home?lang=en"
    },
    {
      "source": "/ar",
      "destination": "/api/home?lang=ar"
    },
    {
      "source": "/ru/catalog/:slug",
      "destination": "/api/catalog/:slug?lang=ru"
    },
    {
      "source": "/tr/catalog/:slug",
      "destination": "/api/catalog/:slug?lang=tr"
    },
    {
      "source": "/en/catalog/:slug",
      "destination": "/api/catalog/:slug?lang=en"
    },
    {
      "source": "/ar/catalog/:slug",
      "destination": "/api/catalog/:slug?lang=ar"
    },
    {
      "source": "/ru/product/:id",
      "destination": "/api/product/:id?lang=ru"
    },
    {
      "source": "/tr/product/:id",
      "destination": "/api/product/:id?lang=tr"
    },
    {
      "source": "/en/product/:id",
      "destination": "/api/product/:id?lang=en"
    },
    {
      "source": "/ar/product/:id",
      "destination": "/api/product/:id?lang=ar"
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|yandex-feed\\.yml|api/).*)",
      "destination": "/index.html"
    }
  ]
}
